# Application identity — read by backend.config.settings.Settings.
# All values here are bound to a single Settings() at startup; the model
# is frozen after that point. See docs/TECH_SPEC.md §13g and ADR-0021.
APP_ENV=development
APP_NAME=perfect-task-tracker
LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Process supervisor (uvicorn CLI arguments). These are NOT consumed by
# the backend's Settings — the process supervisor owns host/port. Wire
# them to the launcher, e.g.:
#
#     uv run uvicorn backend.main:app --host 0.0.0.0 --port 8000
#
# The backend intentionally does not import or log these values.
# scripts/verify_backend.sh passes them as CLI args.
#
# HOST=0.0.0.0   # no longer an env var
# PORT=8000      # no longer an env var

# PostgreSQL — used by both docker-compose and the backend.
# Compose runs the database; the backend reads DATABASE_URL directly.
# The POSTGRES_* family is honored as a convenience: if DATABASE_URL is
# unset and all five POSTGRES_* are set, the backend synthesizes a DSN
# from them. Explicit DATABASE_URL always wins. See Phase 3.3 ADR-0021.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ptt
POSTGRES_USER=ptt
POSTGRES_PASSWORD=ptt

# Backend DSN (constructed or explicit). Leave set to override.
DATABASE_URL=postgresql+psycopg://ptt:ptt@localhost:5433/ptt
